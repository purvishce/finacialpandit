# Copy to .env and fill in values locally. Never commit real credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano-2026-03-17
OPENAI_DECISION_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DATABASE_URL=postgresql://pandit:<password>@localhost:5432/financial_pandit
# For Docker Compose, set this separately with host.docker.internal.
DATABASE_URL_DOCKER=postgresql://pandit:<password>@host.docker.internal:5432/financial_pandit
# Azure AI Search public-knowledge ingestion
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_ENDPOINT=https://srch-financial-pandit-dev.search.windows.net
AZURE_SEARCH_INDEX=ai-finacial-advisor-1234
AZURE_SEARCH_API_VERSION=2024-07-01
